# Supabase — Client-Variablen (NEXT_PUBLIC_* werden auch im Browser ausgeliefert)
# Werte findest du unter https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: Server-Side Service-Role-Key (NICHT NEXT_PUBLIC_, niemals im Browser!)
# Nur in Server-Komponenten / API-Routes / Edge Functions verwenden, wo RLS umgangen werden muss.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App-Konfiguration ──────────────────────────────────────────────────────
# Basis-URL der Deployment-Umgebung — wird in Email-Templates referenziert.
APP_URL=https://project-prepper.dunkelstrom.net

# ── Edge Function Secrets (in supabase secrets gesetzt, nicht hier) ──
# TELEGRAM_BOT_TOKEN          — Token vom @BotFather
# TELEGRAM_WEBHOOK_SECRET     — beliebig, wird in Webhook-URL eingebaut
# SUPABASE_SERVICE_ROLE_KEY   — wird von Supabase automatisch bereitgestellt
