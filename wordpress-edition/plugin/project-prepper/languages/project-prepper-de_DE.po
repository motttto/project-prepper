#. translators: Email subject. Keep the {{rental_number}} and {{site_name}} placeholders unchanged.
#: includes/Email/Notifications.php:38
msgid "Reservation {{rental_number}} — {{site_name}}"
msgstr "Reservierung {{rental_number}} — {{site_name}}"

#. translators: Email body. Keep all {{…}} placeholders unchanged.
#: includes/Email/Notifications.php:40
msgid ""
"Hello {{borrower_name}},\n"
"\n"
"your reservation {{rental_number}} has been recorded:\n"
"\n"
"Period: {{date_from}} to {{date_to}}\n"
"\n"
"Items:\n"
"{{items}}\n"
"\n"
"Best regards\n"
"{{site_name}}"
