"Hallo {{borrower_name}},\n"
"\n"
"das Equipment zu {{rental_number}} wurde ausgegeben.\n"
"\n"
"Rückgabe bis: {{date_to}}\n"
"\n"
"Positionen:\n"
"{{items}}\n"
"\n"
"Viele Grüße\n"
"{{site_name}}"

#. translators: Email subject. Keep the {{rental_number}} placeholder unchanged.
#: includes/Email/Notifications.php:50
msgid "Return confirmed — {{rental_number}}"
msgstr "Rückgabe bestätigt — {{rental_number}}"

#. translators: Email body. Keep all {{…}} placeholders unchanged.
#: includes/Email/Notifications.php:52
msgid ""
"Hello {{borrower_name}},\n"
"\n"
"the return for {{rental_number}} has been confirmed. Thank you!\n"
"\n"
"Best regards\n"
"{{site_name}}"
msgstr ""
"Hallo {{borrower_name}},\n"
"\n"
"die Rückgabe zu {{rental_number}} ist bestätigt. Danke!\n"
"\n"
"Viele Grüße\n"
"{{site_name}}"

